{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigmarail.org/spec/modules/module-manifest-v1.schema.json",
  "title": "SigmaRail Module Manifest v1 (proposal)",
  "description": "Declares ownership, datasets, temporal grain, joins, configuration, and capabilities for a SigmaRail core or optional module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "module_id", "version", "kind", "datasets", "joins", "capabilities"],
  "properties": {
    "contract_version": {"const": 1},
    "module_id": {"type": "string", "pattern": "^sigmarail\\.[a-z][a-z0-9_]{0,61}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "kind": {"enum": ["core_data", "provider_data", "knowledge", "strategy_runtime", "studio_feature"]},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distribution": {"type": "string", "minLength": 1},
        "entry_point_group": {"const": "sigmarail.modules"},
        "entry_point": {"type": "string", "minLength": 1}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module_id", "version_range"],
        "properties": {
          "module_id": {"type": "string", "pattern": "^sigmarail\\.[a-z][a-z0-9_]{0,61}$"},
          "version_range": {"type": "string", "minLength": 1},
          "optional": {"type": "boolean", "default": false}
        }
      },
      "uniqueItems": true
    },
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataset"}
    },
    "joins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_dataset", "to_dataset", "keys", "cardinality", "temporal_alignment"],
        "properties": {
          "id": {"type": "string", "pattern": "^sigmarail\\.[a-z][a-z0-9_.-]{1,127}$"},
          "from_dataset": {"type": "string", "minLength": 1},
          "to_dataset": {"type": "string", "minLength": 1},
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
            }
          },
          "cardinality": {"enum": ["one_to_one", "one_to_many", "many_to_one"]},
          "join_type": {"enum": ["left_any", "inner"], "default": "left_any"},
          "temporal_alignment": {"enum": ["exact", "asof_prior", "completed_period", "event_available_at"]},
          "max_staleness": {"type": ["string", "null"]}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "contract_ref"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,95}$"},
          "kind": {"enum": ["query", "screen", "resource", "tool", "authoring", "execution"]},
          "contract_ref": {"type": "string", "minLength": 1},
          "mcp_resource_uris": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
          "mcp_tool_names": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"}, "uniqueItems": true}
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "required", "secret"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
          "required": {"type": "boolean"},
          "secret": {"type": "boolean"},
          "description": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "table", "frequency", "entity_grain", "time_key", "as_of_semantics", "source_ids"],
      "anyOf": [{"required": ["fields"]}, {"required": ["schema_ref"]}],
      "properties": {
        "dataset_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
        "table": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,126}$"},
        "database": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$", "description": "Optional explicit database override; otherwise use the configured module database."},
        "frequency": {"enum": ["intraday", "daily", "weekly", "monthly", "event", "unspecified"]},
        "entity_grain": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "time_key": {"type": ["string", "null"]},
        "as_of_semantics": {"enum": ["observation_time", "public_available_at", "period_end", "event_available_at", "not_temporal", "unspecified"]},
        "completion": {"enum": ["completed", "provisional", "point_in_time", "event", "not_applicable", "unspecified"]},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "schema_ref": {"type": "string", "format": "uri"},
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_id", "name", "type"],
            "properties": {
              "field_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,126}$"},
              "type": {"type": "string", "minLength": 1},
              "nullable": {"type": "boolean"},
              "units": {"type": ["string", "null"]},
              "semantic_ref": {"type": ["string", "null"]},
              "lineage_ref": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
