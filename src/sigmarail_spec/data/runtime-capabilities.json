                    },
                    {
                      "type": "lit",
                      "value": 1e-09
                    }
                  ],
                  "op": "+",
                  "type": "formula"
                },
                "type": "gt"
              },
              {
                "items": [
                  {
                    "left": {
                      "field": "r",
