  "default_exit_rules": [
    {
      "description": "Once the trade is ≥3R in profit, trail the protective stop 15% under the highest price since entry — the runner's giveback ceiling. Non-terminal: only raises the stop.",
      "name": "chandelier_trail",
      "priority": -5,
      "tag": "trailing_stop",
      "then": [
        {
          "mode": "max",
          "to": {
            "args": [
              {
                "field": "highest_price",
                "type": "pos"
              },
              {
                "type": "lit",
                "value": 0.85
              }
            ],
            "op": "*",
            "type": "formula"
          },
          "type": "ratchet_stop"
        }
      ],
      "when": {
        "left": {
          "field": "r",
          "type": "pos"
        },
        "right": {
          "type": "lit",
          "value": 3.0
        },
        "type": "gte"
      }
    },
    {
      "description": "Exit the whole position when price breaches a ratcheted stop and the trail regime is armed (stop above initial AND r≥arm or runner). Tags the exit as 'trailing' and suppresses re-entry for the cooldown window.",
      "name": "trailing_stop",
      "priority": 0,
      "tag": "trailing_stop",
      "then": [
        {
          "fraction": 1.0,
          "type": "exit"
        },
        {
          "days": 10,
          "type": "arm_cooldown"
        }
      ],
      "when": {
        "items": [
          {
            "left": {
              "field": "check_price",
              "type": "pos"
            },
            "right": {
              "field": "current_stop",
              "type": "pos"
            },
            "type": "lte"
          },
          {
            "items": [
