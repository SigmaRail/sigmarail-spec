{
  "$defs": {
    "AllWhere": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "all": "#/$defs/AllWhere",
                "any": "#/$defs/AnyWhere",
                "eq": "#/$defs/CmpEq",
                "gt": "#/$defs/CmpGt",
                "gte": "#/$defs/CmpGte",
                "lt": "#/$defs/CmpLt",
                "lte": "#/$defs/CmpLte",
                "not": "#/$defs/NotWhere"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AllWhere"
              },
              {
                "$ref": "#/$defs/AnyWhere"
              },
              {
                "$ref": "#/$defs/NotWhere"
              },
              {
                "$ref": "#/$defs/CmpGt"
              },
              {
                "$ref": "#/$defs/CmpGte"
              },
              {
                "$ref": "#/$defs/CmpLt"
              },
              {
                "$ref": "#/$defs/CmpLte"
              },
              {
                "$ref": "#/$defs/CmpEq"
              }
            ]
          },
          "title": "Items",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "const": "all",
          "default": "all",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "AllWhere",
      "type": "object"
    },
    "AnyWhere": {
