              "$ref": "#/$defs/LitVal"
            },
            {
              "$ref": "#/$defs/FormulaExpr"
            }
          ],
          "title": "Right"
        },
        "type": {
          "const": "eq",
          "default": "eq",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "CmpEq",
      "type": "object"
    },
    "CmpGt": {
