          "title": "Left"
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColRef"
            },
            {
              "$ref": "#/$defs/LitVal"
            },
            {
              "$ref": "#/$defs/FormulaExpr"
            }
          ],
          "title": "Right"
        },
        "type": {
          "const": "gt",
          "default": "gt",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "CmpGt",
      "type": "object"
    },
    "CmpGte": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColRef"
            },
            {
              "$ref": "#/$defs/LitVal"
            },
            {
              "$ref": "#/$defs/FormulaExpr"
            }
          ],
          "title": "Left"
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColRef"
            },
            {
              "$ref": "#/$defs/LitVal"
            },
            {
              "$ref": "#/$defs/FormulaExpr"
            }
          ],
          "title": "Right"
        },
        "type": {
          "const": "gte",
          "default": "gte",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "CmpGte",
      "type": "object"
    },
    "CmpLt": {
      "additionalProperties": false,
      "properties": {
