              }
            ]
          },
          "title": "Items",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "const": "any",
          "default": "any",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "AnyWhere",
      "type": "object"
    },
    "CmpEq": {
